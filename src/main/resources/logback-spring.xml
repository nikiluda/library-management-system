<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty
        scope="context"
        name="LOG_DIR"
        source="logging.file.path"
        defaultValue="logs"/>


    <springProfile name="dev">
        <include resource="logback/logback-dev.xml"/>
    </springProfile>

    <springProfile name="int">
        <include resource="logback/logback-int.xml"/>
    </springProfile>

    <springProfile name="prod">
        <include resource="logback/logback-prod.xml"/>
    </springProfile>

    <springProfile name="!dev &amp; !int &amp; !prod">
        <include resource="logback/logback-dev.xml"/>
    </springProfile>

</configuration>
<?xml version="1.0" encoding="UTF-8"?>
<included>


    <appender name="TEXT_CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [traceId=%X{traceId:-no-trace}] %logger{36} - %msg %kvp%n%ex{full}</pattern>
        </encoder>

    </appender>


    <appender name="INT_JSON_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/application-int.json</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR}/archive/application-int.%d{yyyy-MM-dd}.%i.json.gz
            </fileNamePattern>

            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>

        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <threadName/>
                <loggerName/>
                <mdc/>
                <keyValuePairs/>
                <message/>
                <stackTrace/>
            </providers>
        </encoder>

    </appender>


    <appender name="ASYNC_INT_JSON_FILE"
              class="ch.qos.logback.classic.AsyncAppender">

        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>

        <appender-ref ref="INT_JSON_FILE"/>

    </appender>


    <appender name="INT_AUDIT_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/audit-int.json</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR}/archive/audit-int.%d{yyyy-MM-dd}.%i.json.gz
            </fileNamePattern>

            <maxFileSize>20MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <threadName/>
                <loggerName/>
                <mdc/>
                <keyValuePairs/>
                <message/>
                <stackTrace/>
            </providers>
        </encoder>

    </appender>


    <logger name="org.springframework" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <logger name="com.zhanlin.library_management_system" level="INFO"/>


    <logger name="AUDIT"
            level="INFO"
            additivity="false">

        <appender-ref ref="INT_AUDIT_FILE"/>

    </logger>

    <root level="INFO">
        <appender-ref ref="TEXT_CONSOLE"/>
        <appender-ref ref="ASYNC_INT_JSON_FILE"/>
    </root>

</included>
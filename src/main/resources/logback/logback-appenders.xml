<?xml version="1.0" encoding="UTF-8"?>
<included>

    <property name="LOG_DIR" value="logs"/>

    <!-- ================= CONSOLE ================= -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [trace=%X{traceID}] %logger{36} - %msg%n</pattern>
        </encoder>

    </appender>

    <!-- ================= APPLICATION ================= -->

    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/application.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR}/archive/application.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>

        </rollingPolicy>

        <encoder>

            <charset>UTF-8</charset>

            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [trace=%X{traceID}] %logger{36} - %msg%n</pattern>

        </encoder>

    </appender>

    <!-- ================= AUDIT ================= -->

    <appender name="AUDIT_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/audit.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR}/archive/audit.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <maxFileSize>20MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

        <encoder>

            <charset>UTF-8</charset>

            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS}
                %-5level
                [trace=%X{traceID}]
                %msg%n
            </pattern>

        </encoder>

    </appender>

    <!-- ================= JSON APPLICATION ================= -->

    <appender name="JSON_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/application.json</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_DIR}/archive/application-json.%d{yyyy-MM-dd}.%i.json.gz
            </fileNamePattern>

            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>

        </rollingPolicy>

        <encoder
                class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">

            <providers>

                <timestamp/>

                <logLevel/>

                <threadName/>

                <loggerName/>

                <mdc/>

                <message/>

                <stackTrace/>

            </providers>

        </encoder>

    </appender>

    <!-- ================= ASYNC APPLICATION ================= -->

    <appender name="ASYNC_FILE"
              class="ch.qos.logback.classic.AsyncAppender">

        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>

        <appender-ref ref="FILE"/>

    </appender>

    <!-- ================= ASYNC JSON ================= -->

    <appender name="ASYNC_JSON"
              class="ch.qos.logback.classic.AsyncAppender">

        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>

        <appender-ref ref="JSON_FILE"/>

    </appender>

    <!-- ================= ASYNC AUDIT ================= -->

    <appender name="ASYNC_AUDIT"
              class="ch.qos.logback.classic.AsyncAppender">

        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>

        <appender-ref ref="AUDIT_FILE"/>

    </appender>

</included>